{
 "name": "shopping_admin_collect",
 "site": "shopping_admin",
 "gpu": true,
 "server": "vllm",
 "model": "QuantTrio/Qwen3-VL-30B-A3B-Instruct-AWQ",
 "vllm_args": "--tensor-parallel-size 2 --quantization awq --dtype float16 --enforce-eager --max-model-len 8192 --gpu-memory-utilization 0.92 --max-num-batched-tokens 4096 --limit-mm-per-prompt '{\"image\":1}'",
 "steps": [
  {
   "mode": "collect",
   "out": "out_collect",
   "hours": 8.5,
   "run_args": "--concurrency 16 --seed 1 --limit 1200 --crawl-pages 400 --deadline-min 450"
  },
  {
   "cmd": "python -m wa.relabel --inputs /kaggle/working/out_collect --out /kaggle/working/out_relabel --model QuantTrio/Qwen3-VL-30B-A3B-Instruct-AWQ --endpoint http://localhost:8000/v1 --concurrency 16",
   "hours": 2
  }
 ]
}